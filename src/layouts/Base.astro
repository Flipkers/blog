---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: URL;
  ogType?: 'website' | 'article';
  htmlLang?: 'en' | 'ru';
}

const {
  title,
  description = 'A minimal personal blog.',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  ogType = 'website',
  htmlLang = 'en',
} = Astro.props;

const siteTitle = 'Leonid Mikhalev';
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href={`${import.meta.env.BASE_URL}rss.xml`}
    />
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <p class="site-title">
          <a href={import.meta.env.BASE_URL}>{siteTitle}</a>
        </p>
        <div class="site-header-end">
          <nav class="site-nav" aria-label="Primary">
            <a href={import.meta.env.BASE_URL}>Writing</a>
            <a href={`${import.meta.env.BASE_URL}about/`}>About</a>
          </nav>
          <p class="lang-filter" role="navigation" aria-label="Language filter">
            <a href={`${import.meta.env.BASE_URL}?lang=all`} data-lang-filter="all">All</a>
            <span class="lang-filter-sep" aria-hidden="true">·</span>
            <a href={`${import.meta.env.BASE_URL}?lang=en`} data-lang-filter="en">EN</a>
            <span class="lang-filter-sep" aria-hidden="true">·</span>
            <a href={`${import.meta.env.BASE_URL}?lang=ru`} data-lang-filter="ru">RU</a>
          </p>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} {siteTitle}</p>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var allowed = { all: 1, en: 1, ru: 1 };
        var links = document.querySelectorAll('[data-lang-filter]');
        var items = document.querySelectorAll('#post-list > li[data-lang]');
        var empty = document.getElementById('lang-empty');
        var onHome = items.length > 0;

        function apply(lang) {
          if (!allowed[lang]) lang = 'all';
          if (onHome) {
            var visible = 0;
            items.forEach(function (li) {
              var show = lang === 'all' || li.getAttribute('data-lang') === lang;
              li.hidden = !show;
              if (show) visible += 1;
            });
            if (empty) empty.hidden = visible > 0;
          }
          links.forEach(function (link) {
            var active = link.getAttribute('data-lang-filter') === lang;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
          try {
            localStorage.setItem('blog-lang', lang);
          } catch (_) {}
          if (onHome) {
            try {
              var url = new URL(window.location.href);
              if (lang === 'all') url.searchParams.delete('lang');
              else url.searchParams.set('lang', lang);
              history.replaceState(null, '', url);
            } catch (_) {}
          }
        }

        var fromQuery = null;
        try {
          fromQuery = new URLSearchParams(window.location.search).get('lang');
        } catch (_) {}
        var stored = null;
        try {
          stored = localStorage.getItem('blog-lang');
        } catch (_) {}
        apply(fromQuery || stored || 'all');

        links.forEach(function (link) {
          link.addEventListener('click', function (event) {
            if (!onHome) return;
            event.preventDefault();
            apply(link.getAttribute('data-lang-filter'));
          });
        });
      })();
    </script>
  </body>
</html>
