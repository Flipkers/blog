---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  lang?: 'en' | 'ru';
}

const { title, description, pubDate, lang = 'en' } = Astro.props;
const formattedDate = pubDate.toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={title} description={description} ogType="article" htmlLang={lang}>
  <article>
    <h1 class="page-title">{title}</h1>
    <p class="page-date">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </p>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
