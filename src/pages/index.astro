---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Base title="Leonid Mikhalev" description="Essays and notes on building, technology, and attention.">
  <h1 class="page-title">Writing</h1>
  <p class="page-lede">Short essays on software, craft, and how ideas travel.</p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}${post.id}/`}>{post.data.title}</a>
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
        </li>
      ))
    }
  </ul>
</Base>
